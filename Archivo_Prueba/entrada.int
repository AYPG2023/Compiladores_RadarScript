(=, 120, -, distancia)
(=, 85.5, -, viento)
(=, 'NORTE', -, zona)
(=, True, -, alerta_activa)
(>, viento, 70, t1)
(JF, t1, -, L1)
(CONCAT, 'Tormenta detectada en ', zona, t2)
(ALERTA, t2, -, -)
(LABEL, -, -, L1)
(LABEL, -, -, L2)
(>, distancia, 0, t3)
(JF, t3, -, L3)
(-, distancia, 30, t4)
(=, t4, -, distancia)
(JMP, -, -, L2)
(LABEL, -, -, L3)
(REPORTE, 'Proceso finalizado', -, -)
